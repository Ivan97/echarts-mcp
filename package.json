{
  "name": "@ivan97/echarts-mcp",
  "version": "0.2.0",
  "description": "Apache ECharts MCP server. 18 chart types, stdio + Streamable HTTP, SVG/PNG/option/HTML output. Zero native dependencies by default.",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && chmod +x dist/transport/stdio.js dist/transport/http.js",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "echarts",
    "mcp",
    "model-context-protocol",
    "chart",
    "charts",
    "visualization",
    "data-visualization",
    "svg",
    "llm",
    "ai"
  ],
  "author": "Ivan97",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "echarts": "^6.1.0",
    "echarts-liquidfill": "^3.1.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "echarts-simple-transform": "^1.0.0",
    "echarts-stat": "^1.2.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "bin": {
    "echarts-mcp": "dist/transport/stdio.js",
    "echarts-mcp-http": "dist/transport/http.js"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "canvas": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Ivan97/echarts-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ivan97/echarts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Ivan97/echarts-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "overrides": {
    "echarts-liquidfill": {
      "echarts": "$echarts"
    }
  },
  "bundleDependencies": [
    "echarts-liquidfill"
  ]
}

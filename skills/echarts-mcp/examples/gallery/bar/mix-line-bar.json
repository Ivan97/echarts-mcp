{
  "$comment": "由 scripts/build-gallery.mjs 从官方示例求值生成。option 可直接作为 render_option 的参数。",
  "id": "mix-line-bar",
  "category": "bar",
  "title": "Mixed Line and Bar",
  "titleCN": "折柱混合",
  "difficulty": 4,
  "tags": ["多系列","双轴","含函数"],
  "points": 36,
  "upstream": "https://echarts.apache.org/examples/examples/ts/mix-line-bar.ts",
  "functionFields": ["series[0].tooltip.valueFormatter","series[1].tooltip.valueFormatter","series[2].tooltip.valueFormatter"],
  "functionNote": "这些字段是函数字符串：svg/png 输出会被剥离，只有 output=html 由浏览器执行。",
  "option": {
    "tooltip": {"trigger":"axis","axisPointer":{"type":"cross","crossStyle":{"color":"#999"}}},
    "toolbox": {
      "feature": {
        "dataView": {"show":true,"readOnly":false},
        "magicType": {"show":true,"type":["line","bar"]},
        "restore": {"show":true},
        "saveAsImage": {"show":true}

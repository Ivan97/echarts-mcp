{
  "$comment": "由 scripts/build-gallery.mjs 从官方示例求值生成。option 可直接作为 render_option 的参数。",
  "id": "line-draggable",
  "category": "line",
  "title": "Draggable Points",
  "titleCN": "可拖拽点",
  "difficulty": 12,
  "tags": ["数据缩放","平滑","含函数"],
  "points": 5,
  "upstream": "https://echarts.apache.org/examples/examples/ts/line-draggable.ts",
  "functionFields": ["tooltip.formatter"],
  "functionNote": "这些字段是函数字符串：svg/png 输出会被剥离，只有 output=html 由浏览器执行。",
  "option": {
    "title": {"text":"Try Dragging these Points","left":"center"},
    "tooltip": {
      "triggerOn": "none",
      "formatter": "function (params) {\n            return ('X: ' +\n                params.data[0].toFixed(2) +\n                '<br>Y: ' +\n                params.data[1].toFixed(2));\n        }"
    },
    "grid": {"top":"8%","bottom":"12%"},
    "xAxis": {"min":-100,"max":70,"type":"value","axisLine":{"onZero":false}},
    "yAxis": {"min":-30,"max":60,"type":"value","axisLine":{"onZero":false}},
    "dataZoom": [
      {"type":"slider","xAxisIndex":0,"filterMode":"none"},
      {"type":"slider","yAxisIndex":0,"filterMode":"none"},
      {"type":"inside","xAxisIndex":0,"filterMode":"none"},
      {"type":"inside","yAxisIndex":0,"filterMode":"none"}
    ],
    "series": [
      {
        "id": "a",
        "type": "line",
        "smooth": true,
        "symbolSize": 20,
        "data": [[40,-10],[-30,-5],[-76.5,20],[-63.5,40],[-22.1,50]]
      }
    ]
  }
}

{
  "$comment": "由 scripts/build-gallery.mjs 从官方示例求值生成。option 可直接作为 render_option 的参数。",
  "id": "line-tooltip-touch",
  "category": "line",
  "title": "Tooltip and DataZoom on Mobile",
  "titleCN": "移动端上的 dataZoom 和 tooltip",
  "difficulty": 10,
  "tags": ["多系列","堆叠","时间轴","数据缩放","平滑","面积","渐变色","含函数"],
  "points": 18,
  "upstream": "https://echarts.apache.org/examples/examples/ts/line-tooltip-touch.ts",
  "functionFields": ["tooltip.position","xAxis.axisPointer.label.formatter"],
  "functionNote": "这些字段是函数字符串：svg/png 输出会被剥离，只有 output=html 由浏览器执行。",
  "option": {
    "title": {"left":"center","text":"Tootip and dataZoom on Mobile Device"},
    "legend": {"top":"bottom","data":["Intention"]},
    "tooltip": {"triggerOn":"none","position":"function (pt) {\n            return [pt[0], 130];\n        }"},
    "toolbox": {"left":"center","itemSize":25,"top":55,"feature":{"dataZoom":{"yAxisIndex":"none"},"restore":{}}},
    "xAxis": {
      "type": "time",
      "axisPointer": {
        "value": "2016-10-7",
        "snap": true,
        "lineStyle": {"color":"#7581BD","width":2},
        "label": {
          "show": true,
          "formatter": "function (params) {\n                    return echarts.format.formatTime('yyyy-MM-dd', params.value);\n                }",
          "backgroundColor": "#7581BD"
        },
        "handle": {"show":true,"color":"#7581BD"}
      },
      "splitLine": {"show":false}
    },
    "yAxis": {
      "type": "value",
      "axisTick": {"inside":true},
      "splitLine": {"show":false},
      "axisLabel": {"inside":true,"formatter":"{value}\n"},
      "z": 10
    },
    "grid": {"top":110,"left":15,"right":15,"height":160},
    "dataZoom": [{"type":"inside","throttle":50}],
    "series": [
      {
        "name": "Fake Data",
        "type": "line",
        "smooth": true,
        "symbol": "circle",
        "symbolSize": 5,
        "sampling": "average",
        "itemStyle": {"color":"#0770FF"},
        "stack": "a",
        "areaStyle": {
          "color": {
            "colorStops": [{"offset":0,"color":"rgba(58,77,233,0.8)"},{"offset":1,"color":"rgba(58,77,233,0.3)"}],
            "x": 0,
            "y": 0,
            "x2": 0,
            "y2": 1,
            "type": "linear",
            "global": false
          }
        },
        "data": [
          ["2016-10-4",47],
          ["2016-10-5",44],
          ["2016-10-6",52],
          ["2016-10-7",47],
          ["2016-10-8",49],
          ["2016-10-9",45],
          ["2016-10-10",42],
          ["2016-10-11",47],
          ["2016-10-12",40]
        ]
      },
      {
        "name": "Fake Data",
        "type": "line",
        "smooth": true,
        "stack": "a",
        "symbol": "circle",
        "symbolSize": 5,
        "sampling": "average",
        "itemStyle": {"color":"#F2597F"},
        "areaStyle": {
          "color": {
            "colorStops": [{"offset":0,"color":"rgba(213,72,120,0.8)"},{"offset":1,"color":"rgba(213,72,120,0.3)"}],
            "x": 0,

{
  "$comment": "由 scripts/build-gallery.mjs 从官方示例求值生成。option 可直接作为 render_option 的参数。",
  "id": "funnel-customize",
  "category": "funnel",
  "title": "Customized Funnel",
  "titleCN": "漏斗图",
  "difficulty": 10,
  "tags": ["多系列"],
  "points": 10,
  "upstream": "https://echarts.apache.org/examples/examples/ts/funnel-customize.ts",
  "option": {
    "title": {"text":"Funnel"},
    "tooltip": {"trigger":"item","formatter":"{a} <br/>{b} : {c}%"},
    "toolbox": {"feature":{"dataView":{"readOnly":false},"restore":{},"saveAsImage":{}}},
    "legend": {"data":["Show","Click","Visit","Inquiry","Order"]},
    "series": [
      {
        "name": "Expected",
        "type": "funnel",
        "left": "10%",
        "width": "80%",
        "label": {"formatter":"{b}Expected"},
        "labelLine": {"show":false},
        "itemStyle": {"opacity":0.7},
        "emphasis": {"label":{"position":"inside","formatter":"{b}Expected: {c}%"}},
        "data": [
          {"value":60,"name":"Visit"},
          {"value":40,"name":"Inquiry"},
          {"value":20,"name":"Order"},
          {"value":80,"name":"Click"},
          {"value":100,"name":"Show"}
        ]
      },
      {
        "name": "Actual",
        "type": "funnel",
        "left": "10%",
        "width": "80%",
        "maxSize": "80%",
        "label": {"position":"inside","formatter":"{c}%","color":"#fff"},
        "itemStyle": {"opacity":0.5,"borderColor":"#fff","borderWidth":2},
        "emphasis": {"label":{"position":"inside","formatter":"{b}Actual: {c}%"}},
        "data": [
          {"value":30,"name":"Visit"},
          {"value":10,"name":"Inquiry"},
          {"value":5,"name":"Order"},
          {"value":50,"name":"Click"},
          {"value":80,"name":"Show"}
        ],
        "z": 100
      }
    ]
  }
}

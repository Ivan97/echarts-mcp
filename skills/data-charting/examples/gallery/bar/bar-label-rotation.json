{
  "$comment": "由 scripts/build-gallery.mjs 从官方示例求值生成。option 可直接作为 render_option 的参数。",
  "id": "bar-label-rotation",
  "category": "bar",
  "title": "Bar Label Rotation",
  "titleCN": "柱状图标签旋转",
  "difficulty": 3,
  "tags": ["多系列","富文本标签"],
  "points": 20,
  "upstream": "https://echarts.apache.org/examples/examples/ts/bar-label-rotation.ts",
  "option": {
    "tooltip": {"trigger":"axis","axisPointer":{"type":"shadow"}},
    "legend": {"data":["Forest","Steppe","Desert","Wetland"]},
    "toolbox": {
      "show": true,
      "orient": "vertical",
      "left": "right",
      "top": "center",
      "feature": {
        "mark": {"show":true},
        "dataView": {"show":true,"readOnly":false},
        "magicType": {"show":true,"type":["line","bar","stack"]},
        "restore": {"show":true},
        "saveAsImage": {"show":true}
      }
    },
    "xAxis": [{"type":"category","axisTick":{"show":false},"data":["2012","2013","2014","2015","2016"]}],
    "yAxis": [{"type":"value"}],
    "series": [
      {
        "name": "Forest",
        "type": "bar",
        "barGap": 0,
        "label": {
          "show": true,
          "position": "insideBottom",
          "distance": 15,
          "align": "left",
          "verticalAlign": "middle",
          "rotate": 90,
          "formatter": "{c}  {name|{a}}",
          "fontSize": 16,
          "rich": {"name":{}}
        },
        "emphasis": {"focus":"series"},
        "data": [320,332,301,334,390]
      },
      {"name":"Steppe","type":"bar","label":null,"emphasis":{"focus":"series"},"data":[220,182,191,234,290]},
      {"name":"Desert","type":"bar","label":null,"emphasis":{"focus":"series"},"data":[150,232,201,154,190]},
      {"name":"Wetland","type":"bar","label":null,"emphasis":{"focus":"series"},"data":[98,77,101,99,40]}
    ]
  }
}

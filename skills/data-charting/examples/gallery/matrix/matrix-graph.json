            "textVerticalAlign": "bottom",
            "fontSize": 18,
            "fontWeight": "bold",
            "fill": "#333"
          }
        },
        {
          "type": "text",
          "x": 65,
          "y": 270,
          "style": {
            "text": "Course Categories",
            "textAlign": "center",
            "textVerticalAlign": "bottom",
            "fontSize": 18,
            "fontWeight": "bold",
            "fill": "#333"
          },
          "rotation": 1.5707963267948966
        }
      ]
    }
